;; Cross-repo exotype for M-file-change-hygiene.
;;
;; This is deliberately a data-flow map, not a claim that all boxes are live.
;; The :implementation value distinguishes the first executable seam from the
;; later mission slices.  Scoped vertices prevent similarly named facts at
;; different boundaries from being mistaken for the same wire.
{:spec/id :file-change-hygiene-cross-repo
 :field-types
 {:file-occurrence :hygiene/occurrence
  :authority-reading :hygiene/authority-reading
  :change-hint :hygiene/change-hint
  :demand :hygiene/demand
  :currency-result :hygiene/currency-result
  :delivery-evidence :hygiene/delivery-evidence
  :admission :hygiene/admission
  :consumer-reading :hygiene/consumer-reading
  :shadow-observation :hygiene/shadow-observation
  :red-pressure :hygiene/red-pressure
  :scheduled-work :hygiene/scheduled-work}
 :boxes
 [{:box/id :filesystem-observer
   :repo "futon3c"
   :implementation :prototype
   :writes [[:file-occurrence {:record :observation}]]}
  {:box/id :bounded-change-journal
   :repo "futon3c"
   :implementation :prototype
   :reads [[:file-occurrence {:record :observation}]]
   :writes [[:change-hint {:record :journal-entry}]]}
  {:box/id :demand-projector
   :repo "futon3c"
   :implementation :prototype
   :reads [[:change-hint {:record :journal-entry}]]
   :writes [[:demand {:record :currency-request}]]}
  {:box/id :sealed-giraffe-authority
   :repo "futon3c"
   :implementation :live
   :writes [[:authority-reading {:record :sealed-giraffe-run}]]}
  {:box/id :current-giraffe-input-probe
   :repo "futon3c"
   :implementation :prototype
   :writes [[:authority-reading {:record :current-giraffe-input}]]}
  {:box/id :giraffe-shadow-consumer
   :repo "futon3c"
   :implementation :prototype
   :reads [[:change-hint {:record :journal-entry}]
           [:demand {:record :currency-request}]
           [:authority-reading {:record :current-giraffe-input}]]
   :writes [[:consumer-reading {:record :shadow-health}]]
   :constraints {:dispatch-enabled? false
                 :retention :bounded}}
  {:box/id :durable-shadow-ledger
   :repo "futon3c"
   :implementation :prototype
   :reads [[:demand {:record :currency-request}]
           [:authority-reading {:record :current-giraffe-input}]]
   :writes [[:shadow-observation {:record :giraffe-demand-observation}]]}
  {:box/id :shadow-history-scorer
   :repo "futon3c"
   :implementation :prototype
   :reads [[:shadow-observation {:record :giraffe-demand-observation}]
           [:authority-reading {:record :sealed-giraffe-run}]]
   :writes [[:consumer-reading {:record :shadow-score}]]}
  {:box/id :test-registry-authority
   :repo "futon3c"
   :implementation :live
   :reads [[:demand {:record :currency-request}]]
   :writes [[:authority-reading {:record :registry-closure}]
            [:currency-result {:record :currency-response}]]}
  {:box/id :hygiene-delivery-adapter
   :repo "futon3c"
   :implementation :live
   :reads [[:authority-reading {:record :registry-closure}]
           [:currency-result {:record :currency-response}]]
   :writes [[:delivery-evidence {:record :currency-response}]]}
  {:box/id :lean-admission-contract
   :repo "mathlib4"
   :implementation :live
   :reads [[:delivery-evidence {:record :currency-response}]]
   :writes [[:admission {:record :currency-response}]]}
  {:box/id :currency-http-consumer
   :repo "futon3c"
   :implementation :live
   :reads [[:admission {:record :currency-response}]]
   :writes [[:consumer-reading {:record :currency-response}]]}
  {:box/id :consumer-health-projector
   :repo "futon3c"
   :implementation :planned
   :reads [[:consumer-reading {:record :currency-response}]
           [:consumer-reading {:record :shadow-health}]
           [:consumer-reading {:record :shadow-score}]]
   :writes [[:red-pressure {:record :hygiene-health}]]}
  {:box/id :giraffe-work-router
   :repo "futon3c"
   :implementation :planned
   :reads [[:red-pressure {:record :hygiene-health}]]
   :writes [[:scheduled-work {:record :giraffe-input}]]}
  {:box/id :ordinary-priority-cascade
   :repo "futon2"
   :implementation :planned
   :reads [[:scheduled-work {:record :giraffe-input}]]}]}
